# Stripe test key (never commit real secrets)
STRIPE_API_KEY=sk_test_replace_me

# Resend API key and verified sender address
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=onboarding@resend.dev

# Migration connection (sync SQLAlchemy driver)
MIGRATOR_DB_URL=postgresql+psycopg://migrator:change_me@127.0.0.1:5432/ecommerce_app

# Application database connection
DB_USER=app_user
DB_PASSWORD=change_me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ecommerce_app

# JWT configuration
JWT_SECRET_KEY=replace_with_a_long_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Persistent local product image directory
PRODUCT_IMAGE_DIR=media/products
